# jumper.pf — air assault.
# Strategy: walk in, then jump forward and kick late in the jump. A kick
# started on airborne frames 17-20 is a landing low: it carries through
# touchdown, hits ducking fighters and goes under a high_block, so it must be
# blocked low. It loses to fighters who poke it out of the air with quick
# grounded attacks: any hit on an airborne fighter knocks it down.
loop {
  if distance > 24 {
    move_forward x5
  } else {
    jump_forward
    wait 15
    kick
  }
}
on_hit { move_back x2 }
