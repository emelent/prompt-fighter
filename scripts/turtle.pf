# turtle.pf — patient defender.
# Strategy: block while the enemy attacks and kick back as soon as it is in
# kick range and not attacking, with a sweep before a 6th kick in a row
# would go stale. Blocking forever is not safe: the 4th block
# in a row breaks the guard, so after 3 blocks it backs off instead. A
# blocked kick is answered with a throw, since a throw beats a block.
loop {
  if enemy.attacking {
    if guard >= 3 { move_back x3 } else { high_block hold 6 }
  } elif in_range(kick) {
    if repeats >= 5 { sweep } else { kick }
  } else {
    high_block hold 8
  }
}
on_block { throw }
on_hit { move_back x3 }
