{
  "name": "prompt-fighter-viewer",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Prompt Fighter replay viewer (Phaser 3 + TypeScript + Vite), embedded in pf serve under /view.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsc --noEmit && vitest run",
    "check": "tsc --noEmit && vitest run && vite build",
    "audio": "sh convert-audio.sh"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
